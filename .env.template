# Tekton Pipeline Configuration
# Copy this file to .env and update with your values
# These values must align with the dev-infrastructure shared server

# RBAC Identity — used in RoleBinding to scope service permissions
RBAC_USER=dev-infra-admin

# Pipeline Namespace (must match dev-infrastructure)
PIPELINE_NAMESPACE=dev-infrastructure-pipelines

# Service Account used by Tekton PipelineRuns
PIPELINE_SERVICE_ACCOUNT=dev-infra

# Container Registry Configuration (k3d managed by dev-infrastructure)
REGISTRY_CLUSTER_HOST=k3d-dev-infra-registry
REGISTRY_CLUSTER_PORT=5000
REGISTRY_PORT=5002

# Git Repository Configuration
GIT_REPO_URL=https://github.com/RizkiRachman/goods-price-comparison-service.git
GIT_REPO_DEFAULT_BRANCH=main
PROPERTIES_REPO_URL=https://github.com/RizkiRachman/goods-price-comparison-properties.git
PROPERTIES_REPO_DEFAULT_BRANCH=main
ENVIRONMENT_NAME=dev

# Vault Configuration (must match dev-infrastructure)
VAULT_ADDRESS_TERRAFORM=http://localhost:8201   # For Terraform provider (host access)
VAULT_ADDRESS_PIPELINE=http://vault-host:8201  # For pipeline tasks (vault-host service DNS)
VAULT_TOKEN=dev-root-token
VAULT_PORT=8201

# Host gateway IP — how k3d pods reach host machine services (Vault, PostgreSQL)
# Leave unset to auto-detect from the k3d node's InternalIP
# HOST_GATEWAY_IP=172.19.0.1

# GitHub Maven Credentials — managed by Vault (local/infrastructure/github)
# Do NOT set these here. Secrets are created via Terraform from Vault.
# GITHUB_USERNAME=  (managed by Vault)
# GITHUB_TOKEN=     (managed by Vault)

# Image Configuration
IMAGE_NAME=goods-price-comparison-service
IMAGE_TAG=latest

# Kubernetes Deployment Configuration
DEPLOYMENT_NAMESPACE=dev-infrastructure
DEPLOYMENT_NAME=goods-price-service
DEPLOYMENT_PORT=8080
# NodePort exposed on the k3d node — reachable by Docker containers (e.g. Gravitee Gateway)
DEPLOYMENT_NODEPORT=30080

# Database Provisioning & Migration Configuration
# DB credentials auto-provisioned from Vault (local/infrastructure/database)
# Pipeline reads/writes to Vault at local/component/<service-name>
INFRA_DB_MOUNT=local/infrastructure
COMPONENT_MOUNT=local/component
POSTGRES_HOST=postgres-host  # PostgreSQL host service
POSTGRES_PORT=5432
MIGRATIONS_PATH=db/migration
COMPONENT_NAME=goods-price-service  # defaults to DEPLOYMENT_NAME if not set

# Gravitee APIM Configuration
# Gravitee runs on host machine (Docker) — accessible via host-service endpoint
GRAVITEE_HOST=gravitee-host
GRAVITEE_PORT=8083            # Management API port
GRAVITEE_GATEWAY_PORT=8082       # Gateway (proxy) port — actual Docker-exposed port
GRAVITEE_LOCAL_HOST=dev.good-prices  # Fake local domain (add to /etc/hosts: 127.0.0.1 dev.good-prices)
GRAVITEE_ORGANIZATION=DEFAULT
GRAVITEE_ENVIRONMENT=DEFAULT
# Context path is the gateway URL path (e.g. /goods-price-service)
GRAVITEE_CONTEXT_PATH=/goods-price-service
# Backend URL: where Gravitee Gateway (Docker) proxies to.
# Auto-detected at runtime: k3d node IP on the shared Docker network + actual NodePort.
# Override only if auto-detection fails.
# GRAVITEE_BACKEND_URL=http://172.21.0.4:32182
# Vault mount for shared Gravitee admin credentials (keys: username, password)
INFRA_GRAVITEE_MOUNT=local/infrastructure
# Gravitee major version: v3, v4, or empty for auto-detect
GRAVITEE_VERSION=

# Security Scan Configuration
SAST_FAIL_ON_CVSS=7          # OWASP: fail if any CVE has CVSS score >= this
DAST_OPENAPI_PATH=/v3/api-docs  # Path to OpenAPI spec on the running service
DAST_FAIL_ON_RISK=2          # ZAP: fail on risk >= (0=Info 1=Low 2=Medium 3=High)

# Container Images (used in Tekton task envsubst)
KUBECTL_IMAGE=bitnami/kubectl:latest
MAVEN_IMAGE=maven:3.9-eclipse-temurin-17
KANIKO_IMAGE=gcr.io/kaniko-project/executor:latest
